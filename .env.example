# mock talks through the whole turn without a model download.
# whisper uses faster-whisper and downloads the model on first start.
VOICEDESK_STT_BACKEND=mock
VOICEDESK_WHISPER_MODEL=tiny
VOICEDESK_WHISPER_DEVICE=cpu
VOICEDESK_WHISPER_COMPUTE_TYPE=int8
VOICEDESK_WHISPER_LANGUAGE=en
VOICEDESK_MOCK_TRANSCRIPT=hello there

# mock | openai | ollama
VOICEDESK_LLM_BACKEND=mock
VOICEDESK_OPENAI_API_KEY=
VOICEDESK_OPENAI_MODEL=gpt-4o-mini
# Leave empty to use the public OpenAI API.
VOICEDESK_OPENAI_BASE_URL=
VOICEDESK_OLLAMA_BASE_URL=http://127.0.0.1:11434
VOICEDESK_OLLAMA_MODEL=llama3.2

# mock | piper
VOICEDESK_TTS_BACKEND=mock
# Example after: python -m piper.download_voices en_US-lessac-medium --download-dir models
VOICEDESK_PIPER_MODEL_PATH=
VOICEDESK_PIPER_USE_CUDA=false

VOICEDESK_MEMORY_MAX_TURNS=8
VOICEDESK_INTENT_CONFIDENCE_THRESHOLD=0.55
# Optional JSONL file. Leave empty to log timings only to stdout.
VOICEDESK_LATENCY_LOG_PATH=
VOICEDESK_LOG_LEVEL=INFO
